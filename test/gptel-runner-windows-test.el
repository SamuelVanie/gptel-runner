;;; gptel-runner-windows-test.el --- Windows scheduler tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'dom)
(require 'gptel-runner)

(ert-deftest gptel-runner-windows-quotes-native-arguments ()
  (require 'gptel-runner-windows)
  (dolist (pair '(("" . "\"\"") ("plain" . "\"plain\"")
                  ("path with space\\" . "\"path with space\\\\\"")
                  ("cost 50% & $x" . "\"cost 50% & $x\"")))
    (should (equal (gptel-runner-windows--quote (car pair)) (cdr pair))))
  (should (equal (gptel-runner-windows--quote (concat "x" "\\" "\"" "y"))
                 (concat "\"x" (make-string 3 ?\\) "\"y\""))))

(ert-deftest gptel-runner-windows-calendar-and-interval-limits ()
  (require 'gptel-runner-windows)
  (dolist (rule '((:interval 59) (:interval 65) (:interval 2678460)
                  (:calendar ((:minute 30))) (:calendar ((:hour 9 :minute 0 :month 5)))))
    (should-error (gptel-runner-windows--triggers rule) :type 'user-error))
  (let ((valid (gptel-runner-windows--triggers '(:interval 2678400))))
    (should (equal (dom-text (car (dom-by-tag (car valid) 'Interval))) "PT44640M")))
  (let ((rules (cl-loop for minute below 48 collect (list :hour 8 :minute minute))))
    (should (= 48 (length (gptel-runner-windows--triggers (list :calendar rules)))))
    (should-error (gptel-runner-windows--triggers
                   (list :calendar (cons '(:hour 8 :minute 48) rules))) :type 'user-error))
  (let ((daily (gptel-runner-windows--triggers '(:calendar ((:hour 14 :minute 5))))))
    (should (string-suffix-p "T14:05:00" (dom-text (car (dom-by-tag (car daily) 'StartBoundary)))))
    (should (equal (dom-text (car (dom-by-tag (car daily) 'DaysInterval))) "1")))
  (dolist (day '((0 . Sunday) (1 . Monday) (7 . Sunday)))
    (let* ((rules (list (list :hour 9 :minute 30 :weekday (car day))))
           (trigger (car (gptel-runner-windows--triggers (list :calendar rules))))
           (weekly (car (dom-by-tag trigger 'ScheduleByWeek))))
      (should (equal (dom-text (car (dom-by-tag weekly 'WeeksInterval))) "1"))
      (should (dom-by-tag (car (dom-by-tag weekly 'DaysOfWeek)) (cdr day))))))

(ert-deftest gptel-runner-windows-action-and-task-identity ()
  (require 'gptel-runner-windows)
  (let* ((root (make-temp-file "runner task " t))
         (job (list :id "demo" :launchd-id "unique" :schedule '(:interval 120) :root root))
         (command '("C:/Program Files/Emacs/emacs.exe" "--root" "C:/Amy & Bob/"))
         (name (concat "gptel-runner-" (gptel-runner-job-schedule-id job))))
    (unwind-protect
        (let* ((args (gptel-runner-windows-scheduler-arguments 'install job command))
               (file (cadr (member "/XML" args)))
               (task (car (xml-parse-file file))))
          (should (equal args (list "/Create" "/TN" name "/XML" file "/F")))
          (should (file-in-directory-p file root))
          (should (equal (dom-text (car (dom-by-tag task 'Command))) (car command)))
          (should (equal (dom-text (car (dom-by-tag task 'Arguments)))
                         "\"--root\" \"C:/Amy & Bob/\""))
          (should (equal (gptel-runner-windows-scheduler-arguments 'remove job nil)
                         (list "/Delete" "/TN" name "/F")))
          (should (equal (gptel-runner-windows-scheduler-arguments 'diagnostics job nil)
                         (list "/Query" "/TN" name "/XML")))
          (should-error (gptel-runner-windows-scheduler-arguments
                         'install job '("C:/%USERPROFILE%/emacs.exe")) :type 'user-error))
      (delete-directory root t))))

(ert-deftest gptel-runner-windows-protects-unconfirmed-launch ()
  (let ((system-type 'windows-nt) submitted)
    (cl-letf (((symbol-function 'gptel-runner-job-worker-command)
               (lambda (_) '("C:/Program Files/emacs.exe" "--epoch" "1")))
              ((symbol-function 'w32-shell-execute)
               (lambda (&rest args) (setq submitted args)))
              ((symbol-function 'gptel-runner-job-await-worker)
               (lambda (&rest _) (error "Timeout"))))
      (should-error (funcall gptel-runner-job-launch-function '(:epoch 1))
                    :type 'gptel-runner-job-cleanup-error)
      (should (equal submitted '("open" "C:/Program Files/emacs.exe" "\"--epoch\" \"1\"" 0))))))

(ert-deftest gptel-runner-windows-default-and-custom-scheduler-commands ()
  (let* ((gptel-runner-job-directory (make-temp-file "runner Windows " t))
         (job (gptel-runner-register-job "check" :workflow 'check :preload-features nil
                                         :init-file (locate-library "gptel-runner")
                                         :schedule '(:interval 120)))
         (name (concat "gptel-runner-" (gptel-runner-job-schedule-id job)))
         (system-type 'windows-nt)
         (find-program (symbol-function 'executable-find))
         calls)
    (unwind-protect
        ;; Job records live on the host filesystem during the simulated run.
        (cl-letf (((symbol-function 'convert-standard-filename) #'identity)
                  ((symbol-function 'w32-long-file-name) #'identity)
                  ((symbol-function 'executable-find)
                   (lambda (program &rest args)
                     (if (member program '("schtasks.exe" "my scheduler.exe"))
                         (expand-file-name program gptel-runner-job-directory)
                       (apply find-program program args))))
                  ((symbol-function 'gptel-runner-job-call-process)
                   (lambda (program &rest args)
                     (push (cons (file-name-nondirectory program) args) calls)
                     '(:exit 0 :output ""))))
          (gptel-runner-job-schedule job)
          (should (equal (cl-subseq (car calls) 0 4) (list "schtasks.exe" "/Create" "/TN" name)))
          (gptel-runner-jobs--scheduler-call 'diagnostics (gptel-runner-job-get "check"))
          (should (equal (car calls) (list "schtasks.exe" "/Query" "/TN" name "/XML")))
          (gptel-runner-job-unschedule job)
          (should (equal (car calls) (list "schtasks.exe" "/Delete" "/TN" name "/F")))
          (let ((gptel-runner-job-scheduler-program "my scheduler.exe")
                (gptel-runner-job-scheduler-arguments '("--profile" "literal $value")))
            (gptel-runner-job-schedule job))
          (gptel-runner-job-unschedule job)
          (should (equal (car calls)
                         (list "my scheduler.exe" "--profile" "literal $value" "/Delete" "/TN" name "/F")))
          (let ((gptel-runner-job-scheduler-function
                 (lambda (operation _job _action) (list (symbol-name operation)))))
            (gptel-runner-job-schedule job))
          (should (equal (car calls) '("schtasks.exe" "install")))
          (gptel-runner-job-unschedule job)
          (should (equal (car calls) '("schtasks.exe" "remove"))))
      (delete-directory gptel-runner-job-directory t))))

(defun gptel-runner-windows-test--check-result (trigger)
  "Wait for the smoke job's TRIGGER invocation and check its saved result."
  (let ((deadline (+ (float-time) 60)) run)
    (while (and (< (float-time) deadline) (not (eq (plist-get run :phase) 'closed)))
      (sleep-for 0.1)
      (setq run (cl-find-if (lambda (record) (eq (plist-get record :trigger) trigger))
                            (gptel-runner-invocation-list))))
    (ert-info ((format "Expected %s worker, last record %S" trigger run))
      (should (eq (plist-get run :phase) 'closed))
      (should (eq (plist-get run :state) 'succeeded))
      (should (equal (gptel-runner-get run 'value) "done")))))

(ert-deftest gptel-runner-windows-native-scheduler-and-worker ()
  ;; Opt in to registering a temporary task in the current user's scheduler.
  (skip-unless (and (eq system-type 'windows-nt) (getenv "GPTEL_RUNNER_WINDOWS_SMOKE")))
  (let* ((gptel-runner-job-directory (make-temp-file "runner & Windows " t))
         (init (expand-file-name "workflow.el" gptel-runner-job-directory))
         job)
    (unwind-protect
        (progn
          (with-temp-file init
            (prin1 '(gptel-runner-defworkflow native-windows ()
                      (gptel-runner-elisp-step
                       :id 'worker :save-as 'value :function (lambda (_run _node) "done")))
                   (current-buffer)))
          (setq job (gptel-runner-register-job "windows-smoke" :workflow 'native-windows
                                               :init-file init :preload-features nil
                                               :schedule '(:interval 3600)))
          (gptel-runner-job-schedule job)
          (let ((name (concat "gptel-runner-" (gptel-runner-job-schedule-id job))))
            (should (zerop (call-process "schtasks.exe" nil nil nil "/Query" "/TN" name)))
            (should (zerop (call-process "schtasks.exe" nil nil nil "/Run" "/TN" name)))
            (gptel-runner-windows-test--check-result 'schedule)
            (gptel-runner-job-unschedule job)
            (should-not (zerop (call-process "schtasks.exe" nil nil nil "/Query" "/TN" name))))
          (gptel-runner-job-run job)
          (gptel-runner-windows-test--check-result 'manual))
      (when job (gptel-runner-job-delete job))
      (delete-directory gptel-runner-job-directory t))))

(provide 'gptel-runner-windows-test)
;;; gptel-runner-windows-test.el ends here

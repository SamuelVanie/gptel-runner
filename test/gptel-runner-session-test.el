(defmacro gptel-runner-session-test--with-background-chat (ui header &rest body)
  "Open a published chat with UI and HEADER settings, then run BODY."
  (declare (indent 2))
  `(let* ((directory (make-temp-file "runner-chat-header-" t))
          (path (expand-file-name "node.chat" directory))
          (gptel-backend (gptel-make-openai "header-test" :models '(header-test)))
          (gptel-model 'header-test)
          (gptel-use-header-line ,header)
          (gptel-mode-hook (when ,ui '(gptel-ui--maybe-enable)))
          (gptel-ui-mode-hook nil)
          (target '(background-call "header-run" 2 "node"))
          (selection (list (list :directory directory)
                           '(:chat "node.chat" :chat-format gptel) target))
          opened)
     (unwind-protect
         (save-window-excursion
           (with-temp-file path
             (insert ":PROPERTIES:\n:GPTEL_BACKEND: header-test\n"
                     ":GPTEL_MODEL: header-test\n:END:\nWorker answer\n"
                     ";; Local Variables:\n;; mode: org\n;; End:\n"))
           (gptel-runner-background-transcript selection)
           (setq opened (current-buffer))
           ,@body)
       (when (buffer-live-p opened) (kill-buffer opened))
       (delete-directory directory t))))

(defun gptel-runner-session-test--worker-header (target)
  "Check that the current chat retains one working link to TARGET."
  (let* ((parts (flatten-tree header-line-format))
         (link gptel-runner-jobs-ui--controls-link)
         (command (lookup-key (get-text-property 0 'local-map link)
                              [header-line mouse-1]))
         visited)
    (should (= (cl-count link parts :test #'eq) 1))
    (should (member " Local chat copy · " parts))
    (should (equal gptel-runner-background--target target))
    (should (eq (get-text-property 0 'face link) 'link))
    (should (commandp command))
    (cl-letf (((symbol-function 'gptel-runner-background-open)
               (lambda () (setq visited gptel-runner-background--target))))
      (funcall command (list 'mouse-1 (list (selected-window) 'header-line))))
    (should (equal visited target))))


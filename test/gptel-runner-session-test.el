(defun gptel-runner-session-test--change-mode (mode call)
  "Switch the current node chat to MODE without losing CALL's lifecycle."
  (let ((submitted gptel-runner-gptel--submitted-end)
        (rendered gptel-runner-gptel--rendered-end))
    (should (markerp submitted))
    (should (markerp rendered))
    (funcall mode)
    (should (eq gptel-runner--call call))
    (should (eq (gptel-runner-store--chat-owner) call))
    ;; Keep the actual markers shared with the in-flight renderer, not copies.
    (should (eq submitted gptel-runner-gptel--submitted-end))
    (should (eq rendered gptel-runner-gptel--rendered-end))
    (should (eq (marker-buffer rendered) (current-buffer)))
    (should gptel-agent-session-managed-externally)))

(defun gptel-runner-session-test--mode-change-checkpoint ()
  "Verify mode changes during and after a request preserve the saved chat."
  (gptel-runner-session-test--with-run
    (gptel-runner-defworkflow mode-change (:persist t)
      (gptel-runner-agent-step :id 'read :agent 'reader :prompt "Inspect"
                               :completion 'response))
    (let* ((gptel-stream t)
           (run (gptel-runner-start 'mode-change))
           (call (car (gptel-runner-run-calls run)))
           (chat (gptel-runner-node-buffer run 'read))
           (file (gptel-runner-run-snapshot-file run))
           (fsm (pop requests))
           (info (gptel-fsm-info fsm))
           submitted rendered)
      (plist-put info :http-status "200")
      (gptel--fsm-transition fsm)
      (gptel-runner-gptel-test--stream-chunk fsm '(:content "First part"))
      (with-current-buffer chat
        (gptel-runner-session-test--change-mode #'org-mode call)
        (should (eq (gptel-runner-call-state call) 'running))
        (should-not (kill-buffer chat))
        (gptel-mode 1)
        (goto-char (point-max))
        (insert "PRIVATE-UNSENT-DRAFT"))
      (gptel-runner-gptel-test--stream-chunk fsm '(:content " finished") "stop")
      (funcall (plist-get info :callback) t info)
      (gptel--fsm-transition fsm)
      (should (eq (gptel-runner-run-state run) 'succeeded))
      (should-not requests)
      (gptel-runner-store-flush-pending)
      (should (eq (gptel-runner-store-save-status run) 'clean))
      (with-current-buffer chat
        (gptel-runner-session-test--change-mode #'text-mode call)
        ;; Persistence must also work before gptel-mode is re-enabled.
        (should-not gptel-mode)
        (goto-char (point-max))
        (insert " with additional notes")
        (setq submitted (gptel-runner-gptel-submitted-end chat)
              rendered (gptel-runner-gptel-rendered-end chat))
        (goto-char rendered)
        (should (search-forward "PRIVATE-UNSENT-DRAFT" nil t)))
      (should (eq (gptel-runner-store-save-status run) 'pending))
      (gptel-runner-store-flush-pending)
      (should (eq (gptel-runner-store-save-status run) 'clean))
      (should-not (buffer-local-value 'gptel-mode chat))
      (should (kill-buffer chat))
      (should (consp (gethash 'read (gptel-runner-run-chats run))))
      (should (= submitted (plist-get (gptel-runner-call-driver-data call) :submitted-end)))
      (should (= rendered (plist-get (gptel-runner-call-driver-data call) :rendered-end)))
      (gptel-runner-save-run run)
      (gptel-runner-store-flush-pending)
      (should (eq (gptel-runner-store-save-status run) 'clean))
      ;; First reopen the archived chat, then load the saved run from disk.
      (setq chat (gptel-runner-node-buffer run 'read))
      (should (eq (buffer-local-value 'gptel-runner--call chat) call))
      (should (buffer-local-value 'gptel-mode chat))
      (should (= submitted (gptel-runner-gptel-submitted-end chat)))
      (should (= rendered (gptel-runner-gptel-rendered-end chat)))
      (gptel-runner-forget-run run)
      (setq run (gptel-runner-load-run file)
            chat (gptel-runner-node-buffer run 'read)
            call (car (gptel-runner-run-calls run)))
      (with-current-buffer chat
        (should gptel-mode)
        (should (eq gptel-runner--call call))
        (should (= submitted (gptel-runner-gptel-submitted-end chat)))
        (should (= rendered (gptel-runner-gptel-rendered-end chat)))
        (goto-char (point-min))
        (should (search-forward "First part finished" nil t))
        (should (search-forward "PRIVATE-UNSENT-DRAFT with additional notes" nil t))
        (gptel-runner-session-test--change-mode #'org-mode call)
        (goto-char (point-max))
        (insert " after reopening"))
      (should (eq (gptel-runner-store-save-status run) 'pending))
      (should (kill-buffer chat))
      (should (consp (gethash 'read (gptel-runner-run-chats run))))
      (gptel-runner-store-flush-pending)
      (should (eq (gptel-runner-store-save-status run) 'clean)))))


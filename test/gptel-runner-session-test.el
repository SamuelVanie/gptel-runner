            (with-current-buffer clone
              (setq-local gptel-runner--call call)
              (call-interactively #'gptel-abort)
              (should-error (call-interactively #'gptel-runner-pause-call) :type 'user-error)
              (should-not (gptel-runner-ui--run-context))
              (let (checkpoint)
                (cl-letf (((symbol-function 'gptel-runner--checkpoint)
                           (lambda (&rest _) (setq checkpoint t))))
                  (gptel-runner-store--chat-changed))
                (should-not checkpoint))
              (goto-char (point-max))
              (insert "Independent stale-clone request")
              (gptel-send)
              (should-not gptel-runner-gptel--manual-requests))
            (should (eq 'running (gptel-runner-call-state call)))
            (let ((ordinary (pop requests)))
              (should (eq clone (plist-get (gptel-fsm-info ordinary) :buffer)))
              (setf (plist-get (gptel-fsm-info ordinary) :callback) #'gptel--insert-response)
              (gptel-runner-gptel-test--reply ordinary "Clone result" "stop"))
            (gptel-runner-gptel-test--reply original "Source result" "stop")
            (with-current-buffer clone
              (should-error (gptel-runner-complete-call-from-buffer "Wrong result") :type 'user-error))
            (should (eq 'waiting-feedback (gptel-runner-call-state call)))
            (should-not (gptel-runner-get run 'answer))
            (with-current-buffer source (gptel-runner-complete-call-from-buffer))
            (should (equal "Source result" (gptel-runner-get run 'answer)))
            (should (eq 'succeeded (gptel-runner-run-state run))))
        (when (buffer-live-p clone) (kill-buffer clone))))))

(ert-deftest gptel-runner-session-clone-agent-session-coexistence ()
  (skip-unless (and (require 'gptel-agent nil t)
                    (gptel-runner-store--agent-sessions-p)))
  (let ((gptel-agent-session-directory (make-temp-file "runner-clone-session-" t))
        (gptel-agent-session-mode nil)
        (gptel-agent-session-auto-title nil)
        (gptel-agent-session--buffers (make-hash-table :test #'equal))
        (gptel-agent-session--dirty (make-hash-table :test #'eq))
        (gptel-agent-session--queue nil)
        (gptel-agent-session--queue-tail nil)
        clone)
    (unwind-protect
        (gptel-runner-session-test--with-run
          (gptel-agent-session-mode 1)
          (let* ((run (gptel-runner-start
                       (gptel-runner-agent-step :id 'read :agent 'reader :prompt "Inspect")))
                 (source (gptel-runner-node-buffer run 'read))
                 (original (pop requests)))
            (setq clone (with-current-buffer source (clone-buffer " *runner-session-clone*")))
            (let ((id (buffer-local-value 'gptel-agent-session--id clone)))
              (should (stringp id))
              (should (eq clone (gethash id gptel-agent-session--buffers)))
              (should-not (buffer-local-value 'gptel-agent-session--id source))
              (should (buffer-local-value 'gptel-agent-session-managed-externally source))
              (should-not (buffer-local-value 'gptel-agent-session-managed-externally clone))
              (with-current-buffer clone
                (goto-char (point-max))
                (insert "Independent saved draft")
                (call-interactively #'gptel-abort))
              (gptel-agent-session-save)
              (should (string-search "Independent saved draft"
                                     (plist-get (gptel-agent-session--read id) :text)))
              (should (eq source (gptel-runner-node-buffer run 'read)))
              (should (eq 'running (gptel-runner-run-state run)))
              (gptel-runner-gptel-test--handoff original "Original result")
              (should (eq 'succeeded (gptel-runner-run-state run))))))
      (gptel-agent-session-mode -1)
      (when (buffer-live-p clone) (kill-buffer clone))
      (delete-directory gptel-agent-session-directory t))))



(ert-deftest gptel-runner-session-history-survives-missing-inputs ()
  (dolist (missing '(context workspace override))
    (gptel-runner-session-test--with-run
      (let* ((workspace (expand-file-name "workspace/" gptel-runner-snapshot-directory))
             (context (expand-file-name "context.txt" workspace)))
        (make-directory workspace)
        (with-temp-file context (insert "Original context"))
        (gptel-runner-defworkflow historical-inputs (:persist t)
          (gptel-runner-agent-step
           :id 'read :agent 'reader :prompt "Inspect" :completion 'response
           :workspace (and (eq missing 'override) workspace)
           :context (gptel-runner-context-file "context.txt")))
        (let* ((run (gptel-runner-start
                     'historical-inputs :workspace
                     (if (eq missing 'override) gptel-runner-snapshot-directory workspace)))
               (file (gptel-runner-run-snapshot-file run)))
          (gptel-runner-gptel-test--reply (pop requests) "Archived findings" "stop")
          (gptel-runner-forget-run run)
          (if (eq missing 'context) (delete-file context) (delete-directory workspace t))
          (setq run (gptel-runner-load-run file))
          (should (eq (gptel-runner-run-state run) 'succeeded))
          (with-current-buffer (gptel-runner-node-buffer run 'read)
            (should (string-search "Archived findings" (buffer-string))))
          (should-not requests)
          ;; Viewing history needs no old files, but new execution still does.
          (gptel-runner-rerun run)
          (should (eq (gptel-runner-run-state run) 'failed))
          (should-not requests))))))

(ert-deftest gptel-runner-session-resume-checks-only-unfinished-inputs ()
  (dolist (missing '(finished unfinished))
    (gptel-runner-session-test--with-run
      (let* ((first (expand-file-name "first.txt" gptel-runner-snapshot-directory))
             (second (expand-file-name "second.txt" gptel-runner-snapshot-directory)))
        (dolist (file (list first second))
          (with-temp-file file (insert "Original context")))
        (gptel-runner-defworkflow historical-resume (:persist t :completion response)
          (gptel-runner-sequence
           (gptel-runner-agent-step :id 'first :agent 'reader :prompt "First"
                                    :context (gptel-runner-context-file first))
           (gptel-runner-agent-step :id 'second :agent 'reader :prompt "Second"
                                    :context (gptel-runner-context-file second))))
        (let* ((run (gptel-runner-start 'historical-resume))
               (file (gptel-runner-run-snapshot-file run)))
          (gptel-runner-gptel-test--reply (pop requests) "First completed" "stop")
          (should (pop requests))
          (gptel-runner-pause-run run)
          (gptel-runner-forget-run run)
          (delete-file (if (eq missing 'finished) first second))
          (setq run (gptel-runner-load-run file))
          (should (eq (gptel-runner-run-state run) 'paused))
          (gptel-runner-resume-run run)
          (if (eq missing 'finished)
              (progn
                (should (= (length requests) 1))
                (gptel-runner-gptel-test--reply (pop requests) "Second completed" "stop")
                (should (eq (gptel-runner-run-state run) 'succeeded)))
            (should (eq (gptel-runner-run-state run) 'failed)))
          (should-not requests))))))

(ert-deftest gptel-runner-session-history-still-validates-workflow-contracts ()
  (gptel-runner-session-test--with-run
    (gptel-runner-register-agent 'writer :workspace-mode 'write)
    (gptel-runner-defworkflow historical-contracts (:persist t :completion response)
      (gptel-runner-agent-step :id 'read :agent 'reader :prompt "Inspect"))
    (let* ((run (gptel-runner-start 'historical-contracts))
           (file (gptel-runner-run-snapshot-file run))
           (node (gptel-runner-workflow-root (gptel-runner-run-workflow run)))
           (original (gptel-runner-node-properties node)))
      (gptel-runner-gptel-test--reply (pop requests) "Archived findings" "stop")
      (gptel-runner-forget-run run)
      (dolist (change '((:context (:file 42)) (:workspace 42) (:agent writer)))
        (setf (gptel-runner-node-properties node)
              (plist-put (copy-sequence original) (car change) (cadr change)))
        (should-error (gptel-runner-load-run file) :type 'user-error)
        (should-not (gptel-runner-find-run (gptel-runner-run-id run))))
      (should-not requests))))



(ert-deftest gptel-runner-session-indirect-view-preserves-live-node ()
  (gptel-runner-session-test--with-run
    (gptel-runner-defworkflow indirect-node (:persist t :completion response)
      (gptel-runner-agent-step :id 'read :agent 'reader :prompt "Inspect"))
    (let* ((run (gptel-runner-start 'indirect-node))
           (call (car (gptel-runner-run-calls run)))
           (source (gptel-runner-call-buffer call))
           (fsm (pop requests))
           (submitted (buffer-local-value 'gptel-runner-gptel--submitted-end source))
           (rendered (buffer-local-value 'gptel-runner-gptel--rendered-end source))
           view)
      (unwind-protect
          (progn
            (setq view (with-current-buffer source
                         (clone-indirect-buffer " *runner-indirect*" nil)))
            (gptel-runner-store-flush-run run)
            (with-current-buffer view
              (should buffer-read-only)
              (should-not gptel-runner--call)
              (should-not gptel--fsm-last)
              (should-not gptel-runner-gptel--submitted-end)
              (should-not gptel-runner-gptel--rendered-end)
              (should-not gptel-agent-session-managed-externally)
              (should-not (memq #'gptel-runner-store--close-chat kill-buffer-hook))
              (should-not (memq #'gptel-runner-store--allow-chat-kill-p
                                kill-buffer-query-functions))
              (setq buffer-read-only nil)
              (goto-char (point-max))
              (insert "SHARED-DRAFT")
              (should (eq (gptel-runner-store-save-status run) 'pending))
              (should-error (gptel-request) :type 'user-error)
              (should-error (gptel-request "Concurrent request") :type 'user-error)
              (call-interactively #'gptel-abort))
            (with-temp-buffer
              (should-error (gptel-request "Concurrent response" :buffer view)
                            :type 'user-error)
              (should-error (gptel-request "Concurrent named response"
                                          :buffer (buffer-name view))
                            :type 'user-error)
              (should-error (gptel-request nil :buffer (buffer-name view))
                            :type 'user-error)
              (should-error (gptel-request "Concurrent marker response"
                                          :position (with-current-buffer view (point-marker)))
                            :type 'user-error))
            (should-not requests)
            (should (eq (gptel-runner-call-state call) 'running))
            (should (eq fsm (buffer-local-value 'gptel--fsm-last source)))
            (should (gptel--fsm-live-p fsm))
            (should (eq submitted (buffer-local-value 'gptel-runner-gptel--submitted-end source)))
            (should (eq rendered (buffer-local-value 'gptel-runner-gptel--rendered-end source)))
            (dolist (marker (list submitted rendered))
              (when marker (should (eq source (marker-buffer marker)))))
            (gptel-runner-store-flush-run run)
            (with-current-buffer view
              (fundamental-mode)
              (goto-char (point-max))
              (let ((inhibit-read-only t)) (insert " after mode change")))
            (should (eq (gptel-runner-store-save-status run) 'pending))
            (should (kill-buffer view))
            (should (eq (gptel-runner-call-state call) 'running))
            (gptel-runner-gptel-test--reply fsm "Source completed" "stop")
            (should (eq (gptel-runner-run-state run) 'succeeded))
            (with-current-buffer source
              (should (string-search "SHARED-DRAFT" (buffer-string))))
            (gptel-runner-store-flush-run run)
            (let ((file (gptel-runner-run-snapshot-file run)))
              (gptel-runner-forget-run run)
              (setq run (gptel-runner-load-run file))
              (with-current-buffer (gptel-runner-node-buffer run 'read)
                (should (string-search "SHARED-DRAFT" (buffer-string))))))
        (when (buffer-live-p view) (kill-buffer view))))))

(ert-deftest gptel-runner-session-indirect-child-edits-checkpoint-base ()
  (gptel-runner-session-test--with-run
    (gptel-runner-defworkflow indirect-child (:persist t :completion response)
      (gptel-runner-agent-step :id 'read :agent 'reader :prompt "Inspect"))
    (let* ((run (gptel-runner-start 'indirect-child))
           (source (gptel-runner-node-buffer run 'read))
           (child (generate-new-buffer " *runner-indirect-child*"))
           view)
      (unwind-protect
          (progn
            (with-current-buffer child (insert "Child transcript"))
            (gptel-runner-store-track-child source child 'agent)
            (let* ((id (buffer-local-value 'gptel-runner-store--child-id child))
                   (record (gethash id (gptel-runner-run-child-chats run))))
              (setq view (with-current-buffer child
                           (clone-indirect-buffer " *runner-child-view*" nil)))
              (gptel-runner-store-flush-run run)
              (with-current-buffer view
                (should buffer-read-only)
                (should-not gptel-runner-store--child-run)
                (should-not gptel-runner-store--child-id)
                (setq buffer-read-only nil)
                (goto-char (point-max))
                (insert " shared edit")
                (should (eq (gptel-runner-store-save-status run) 'pending)))
              (should (kill-buffer view))
              (should (eq child (plist-get record :chat)))
              (should (eq run (buffer-local-value 'gptel-runner-store--child-run child)))
              (with-current-buffer child
                (should (equal "Child transcript shared edit" (buffer-string)))))
            (gptel-runner-gptel-test--reply (pop requests) "Source completed" "stop")
            (should (eq (gptel-runner-run-state run) 'succeeded)))
        (dolist (buffer (list view child))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))


                (text (concat "Draft body\n;; Local Variables:\n;; mode: text\n"
                              ";; gptel-model: runner-test\n"
                              ";; gptel--backend-name: \"runner-test\"\n"
                              ";; gptel-runner-tool-policy-ceiling: (42)\n;; End:\n")))
            (dolist (failure '(error quit))

;;; gptel-runner-systemd-test.el --- Linux scheduler tests -*- lexical-binding: t; -*-

;;; Commentary:
;; User manager commands are captured and unit files are written to a private
;; directory.  On Linux, systemd-analyze also checks the units offline.

;;; Code:

(require 'ert)
(require 'gptel-runner-systemd)

(defmacro gptel-runner-systemd-test--isolated (&rest body)
  "Run BODY against a private store and a simulated user manager."
  (declare (indent 0) (debug t))
  `(let* ((directory (make-temp-file "runner-systemd-" t))
          (system-type 'gnu/linux)
          (gptel-runner-systemd-directory (expand-file-name "units" directory))
          (gptel-runner-job-directory (expand-file-name "store %h ${HOME}" directory))
          (gptel-runner-job-preload-features nil)
          (job (gptel-runner-register-job
                "checks" :workflow 'checks :init-file (locate-library "gptel-runner")
                :schedule '(:interval 17) :environment '(("RUNNER_TOKEN" . "private value"))))
          (basename (concat "gptel-runner-schedule-" (plist-get job :launchd-id)))
          (timer (concat basename ".timer"))
          (timer-file (expand-file-name timer gptel-runner-systemd-directory))
          (service-file (expand-file-name (concat basename ".service") gptel-runner-systemd-directory))
          calls fail-command)
     (unwind-protect
         (cl-letf (((symbol-function 'gptel-runner-systemd--invoke)
                    (lambda (program &rest args)
                      (push (cons program args) calls)
                      (if (equal (car args) fail-command)
                          '(:exit 1 :output "simulated user manager error")
                        '(:exit 0 :output "")))))
           ,@body)
       (delete-directory directory t))))

(defun gptel-runner-systemd-test--contents (file)
  "Return the text in FILE."
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(ert-deftest gptel-runner-systemd-uses-configured-programs-and-literal-arguments ()
  (let ((system-type 'gnu/linux)
        (gptel-runner-systemctl-command '("/tools/control wrapper" "--profile" "local $HOME"))
        (gptel-runner-systemd-run-command '("worker-wrapper" "--launch")))
    (cl-letf (((symbol-function 'gptel-runner-job-call-process) #'list))
      (should (equal (gptel-runner-systemd--invoke "systemctl" "show" "test.service")
                     '("/tools/control wrapper" "--profile" "local $HOME" "show" "test.service")))
      (should (equal (gptel-runner-systemd--invoke "systemd-run" "--" "/path to/emacs")
                     '("worker-wrapper" "--launch" "--" "/path to/emacs"))))))

(ert-deftest gptel-runner-systemd-schedule-update-and-remove ()
  (gptel-runner-systemd-test--isolated
    (let ((installed (gptel-runner-job-schedule job)))
      (should (eq (plist-get (plist-get installed :scheduler) :state) 'installed))
      (should (equal (reverse calls)
                     (list '("systemctl" "show" "--property=Version" "--value")
                           '("systemctl" "daemon-reload")
                           (list "systemctl" "enable" timer)
                           (list "systemctl" "restart" timer))))
      (dolist (file (list timer-file service-file))
        (should (= #o600 (logand #o777 (file-modes file)))))
      (let ((service (gptel-runner-systemd-test--contents service-file))
            (interval (gptel-runner-systemd-test--contents timer-file)))
        (should (string-search "\"trigger\" \"checks\" \"--root\"" service))
        (should (string-search "store %%h $${HOME}" service))
        (should-not (string-search "private value" service))
        (should (string-search "OnActiveSec=17s\n" interval))
        (should (string-search "OnUnitActiveSec=17s\n" interval))
        (should-not (string-search "OnBootSec=" interval))))
    (let ((rule '(:calendar ((:day 1 :weekday 7 :hour 9 :month 3)
                             (:weekday 0 :minute 25)))))
      (gptel-runner-job-schedule "checks" rule)
      (let ((calendar (gptel-runner-systemd-test--contents timer-file)))
        (dolist (line '("OnCalendar=*-3-1 9:*:00\n"
                        "OnCalendar=Sun *-3-* 9:*:00\n"
                        "OnCalendar=Sun *-*-* *:25:00\n"))
          (should (string-search line calendar)))
        (should-not (string-search "OnUnitActiveSec=" calendar)))
      (setq calls nil)
      (let ((removed (gptel-runner-job-unschedule job)))
        (should (equal (plist-get removed :schedule) rule))
        (should-not (plist-get removed :enabled))
        (should (eq (plist-get (plist-get removed :scheduler) :state) 'removed))
        (should (equal (reverse calls) (list (list "systemctl" "disable" "--now" timer)
                                             '("systemctl" "daemon-reload"))))
        (should-not (file-exists-p timer-file))
        (should-not (file-exists-p service-file))))))

(ert-deftest gptel-runner-systemd-missing-manager-preserves-cli-job ()
  (gptel-runner-systemd-test--isolated
    (setq fail-command "show")
    (should-error (gptel-runner-job-schedule job '(:interval 10)))
    (should (equal job (gptel-runner-job-get "checks")))
    (should-not (file-exists-p gptel-runner-systemd-directory))
    (setq calls nil)
    (gptel-runner-job-delete "checks")
    (should-not calls)
    (should-not (gptel-runner-job-list))))

(ert-deftest gptel-runner-systemd-partial-install-can-be-removed ()
  (gptel-runner-systemd-test--isolated
    (setq fail-command "restart")
    (should-error (gptel-runner-job-schedule job))
    (should (eq (plist-get (plist-get (gptel-runner-job-get "checks") :scheduler) :state)
                'error))
    (setq fail-command "disable")
    (should-error (gptel-runner-job-delete "checks"))
    (should (file-exists-p timer-file))
    (should (file-exists-p service-file))
    (setq fail-command nil)
    (gptel-runner-job-delete "checks")
    (should-not (file-exists-p timer-file))
    (should-not (file-exists-p service-file))
    (should-not (gptel-runner-job-list))))

(ert-deftest gptel-runner-systemd-launches-exact-worker-and-honors-adoption ()
  (gptel-runner-systemd-test--isolated
    (let* ((path (expand-file-name "inv $UID %u" directory))
           (inv (list :id "inv-test" :epoch 2 :job job :directory path))
           (unit "gptel-runner-worker-inv-test-2.service")
           adopted)
      (cl-letf (((symbol-function 'gptel-runner-jobs--await-worker)
                 (lambda (worker _timeout) (setq adopted worker))))
        (should (equal (gptel-runner-jobs--launch inv) unit))
        (should (equal adopted inv))
        (should (= (length calls) 1))
        (let ((args (car calls)))
          (should (equal (car args) "systemd-run"))
          (should (member "--collect" args))
          (should (member (concat "--unit=" unit) args))
          (should (equal (last args 4)
                         (list "worker" (expand-file-name "inv $$UID %u" directory)
                               "--epoch" "2")))
          (should-not (string-search "private value" (prin1-to-string args)))))
      (cl-letf (((symbol-function 'gptel-runner-jobs--await-worker)
                 (lambda (&rest _) (error "Worker did not adopt"))))
        (should-error (gptel-runner-jobs--launch inv))
        (should (equal (car calls) (list "systemctl" "stop" unit)))
        (setq fail-command "stop")
        (should-error (gptel-runner-jobs--launch inv) :type 'gptel-runner-job-cleanup-error)))))

(ert-deftest gptel-runner-systemd-reap-requires-exact-proof-of-absence ()
  (let* ((record '(:launcher systemd :id "inv-test" :epoch 3))
         (unit "gptel-runner-worker-inv-test-3.service")
         closed result)
    (cl-letf (((symbol-function 'gptel-runner-invocation-list) (lambda () (list record)))
              ((symbol-function 'gptel-runner-jobs--abandoned-start-p) (lambda (_) t))
              ((symbol-function 'gptel-runner-jobs--confirm-stopped)
               (lambda (inv) (setq closed inv)))
              ((symbol-function 'gptel-runner-systemd--invoke)
               (lambda (&rest args)
                 (should (equal args (list "systemctl" "show" "--property=LoadState" "--value" unit)))
                 result)))
      (dolist (probe '((:exit 0 :output "loaded") (:exit 1 :output "not-found")
                       (:exit 4 :output "No manager")))
        (setq result probe)
        (gptel-runner-systemd-reap)
        (should-not closed))
      (setq result '(:exit 4 :output "not-found\n"))
      (gptel-runner-systemd-reap)
      (should (eq record closed)))))

(ert-deftest gptel-runner-systemd-units-pass-offline-verification ()
  (skip-unless (and (eq system-type 'gnu/linux) (executable-find "systemd-analyze")))
  (gptel-runner-systemd-test--isolated
    (let ((process-environment (copy-sequence process-environment)))
      (setenv "XDG_RUNTIME_DIR" directory)
      (dolist (rule '((:interval 17) (:calendar ((:weekday 7 :day 31 :minute 15)))))
        (gptel-runner-job-schedule job rule)
        (with-temp-buffer
          (let ((status (call-process "systemd-analyze" nil '(t t) nil
                                      "--user" "verify" timer-file service-file)))
            (ert-info ((buffer-string)) (should (equal status 0)))))))))

(provide 'gptel-runner-systemd-test)
;;; gptel-runner-systemd-test.el ends here

(ert-deftest gptel-runner-jobs-ui-commands-address-the-observed-call-epoch ()
  (let ((run '(:id "invocation-1" :epoch 3 :state running
               :calls ((:id "call-2" :epoch 2 :state waiting-feedback))))
        sent)
    (with-temp-buffer
      (setq-local gptel-runner-background--target
                  '(background-call "invocation-1" 2 "call-2"))
      (cl-letf (((symbol-function 'gptel-runner-invocation-get)
                 (lambda (_id) run))
                ((symbol-function 'gptel-runner-job-command)
                 (lambda (invocation operation arguments)
                   (setq sent (list invocation operation arguments))
                   '(:id "command-1" :state queued)))
                ((symbol-function 'gptel-runner-jobs-ui--display) #'ignore))
        (gptel-runner-background-command 'accept '(:result "accepted"))
        (should (eq (nth 1 sent) 'accept))
        (should (equal (plist-get (nth 2 sent) :call-id) "call-2"))
        (should (= (plist-get (nth 2 sent) :call-epoch) 2))
        (should (equal (plist-get (nth 2 sent) :result) "accepted"))))))


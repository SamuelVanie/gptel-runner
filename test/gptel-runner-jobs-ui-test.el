         (call '(:id "node" :epoch 2 :chat "node.chat"))
         (run (list :calls (list call)
                    :interactions (list '(:call-id "node" :epoch 1))))
         opened)
    (cl-letf (((symbol-function 'gptel-runner-invocation-get) (lambda (_) run))

(ert-deftest gptel-runner-jobs-ui-visits-published-chat-without-losing-drafts ()
  (let* ((directory (make-temp-file "runner-chat-" t))
         (path (expand-file-name "plan.chat" directory))
         (target '(background-call "job" 2 "call"))
         (call '(:id "call" :epoch 2 :chat "plan.chat" :chat-format gptel))
         (run (list :directory directory :calls (list call)))
         copies)
    (unwind-protect
        (save-window-excursion
          (with-temp-file path (insert "First response"))
          (cl-letf (((symbol-function 'gptel-runner-invocation-get) (lambda (_) run))
                    ((symbol-function 'gptel-runner-store-open-chat)
                     (lambda (file format)
                       (should (eq format 'gptel))
                       (let ((buffer (generate-new-buffer " *node chat*")))
                         (push buffer copies)
                         (with-current-buffer buffer (insert-file-contents file))
                         buffer))))
            (gptel-runner-jobs-ui--row-action 'open target)
            (should (equal (buffer-string) "First response"))
            (should (equal gptel-runner-background--target target))
            (insert "My local draft")
            (gptel-runner-background-visit target)
            (should (eq (current-buffer) (car copies)))
            (should (= (length copies) 1))
            (with-temp-file path (insert "Worker follow-up"))
            ;; Give this publication a distinct revision on coarse filesystems.
            (set-file-times path (time-add (current-time) 2))
            (gptel-runner-background-visit target)
            (should (= (length copies) 2))
            (should (equal (buffer-string) "Worker follow-up"))
            (with-current-buffer (cadr copies)
              (should (string-match-p "My local draft" (buffer-string))))))
      (mapc #'kill-buffer copies)
      (delete-directory directory t))))

(ert-deftest gptel-runner-jobs-ui-visits-saved-local-node-chat ()
  (let* ((node (gptel-runner-node-create :id 'plan :kind 'agent))
         (run (gptel-runner-run-create))
         (call (gptel-runner-call-create :run run :node node)))
    (setf (gptel-runner-run-calls run) (list call))
    (puthash 'plan '(gptel . "Saved chat") (gptel-runner-run-chats run))
    (with-temp-buffer
      (let ((chat (current-buffer)) visited)
        (cl-letf (((symbol-function 'pop-to-buffer)
                   (lambda (buffer) (setq visited buffer)))
                  ((symbol-function 'gptel-runner-ui--call-at-point) (lambda () call))
                  ((symbol-function 'gptel-runner-call-chat-buffer)
                   (lambda (selected) (should (eq selected call)) chat))
                  ((symbol-function 'gptel-runner-node-buffer)
                   (lambda (selected-run selected-node)
                     (should (eq selected-run run))
                     (should (eq selected-node node))
                     chat)))
          (gptel-runner-dashboard-open-at-point)
          (should (eq visited chat))
          (setq visited nil)
          (setf (gptel-runner-call-buffer call) chat)
          (setq-local gptel-runner--call call)
          (call-interactively #'gptel-runner-visit-node-chat)
          (should (eq visited chat)))))))

(ert-deftest gptel-runner-dashboard-opens-existing-session-from-its-chat ()
  (let* ((file (make-temp-file "runner-session-" nil ".snapshot.el"))
         (gptel-runner-dashboard-buffer (generate-new-buffer-name "*runner session test*"))
         (gptel-runner-dashboard-refresh-interval nil)
         (gptel-runner-dashboard-entry-functions nil)
         (gptel-runner--runs (make-hash-table :test #'equal))
         (run (gptel-runner-run-create
               :id "run-1" :workflow (gptel-runner-workflow-create :name 'demo)
               :budget (gptel-runner-budget-create) :snapshot-file file))
         saved)
    (puthash "run-1" run gptel-runner--runs)
    (unwind-protect
        (save-window-excursion
          (with-temp-buffer
            (setq-local gptel-runner--call
                        (gptel-runner-call-create :run run :buffer (current-buffer)))
            (cl-letf (((symbol-function 'gptel-runner-load-run)
                       (lambda (_) (ert-fail "Tried to reload a live run")))
                      ((symbol-function 'gptel-runner-save-run)
                       (lambda (selected) (setq saved selected) file)))
              (call-interactively #'gptel-runner-save-session)
              (should (eq saved run))
              (should (eq run (gptel-runner-open-session file)))
              (should (derived-mode-p 'gptel-runner-dashboard-mode))
              (should (equal (tabulated-list-get-id) '(run "run-1"))))))
      (when (get-buffer gptel-runner-dashboard-buffer)
        (kill-buffer gptel-runner-dashboard-buffer))
      (delete-file file))))

(ert-deftest gptel-runner-dashboard-session-picker-distinguishes-runs ()
  (let ((files '("/example/one.snapshot.el" "/example/two.snapshot.el"
                 "/example/old.snapshot.el"))
        (title "review · paused · 2026-11-18 · Inspect the change")
        browse saw-choices)
    (cl-letf (((symbol-function 'gptel-runner-list-snapshots)
               (lambda () (when browse (ert-fail "Browsed the catalog with a prefix")) files))
              ((symbol-function 'gptel-runner-store-session-title)
               (lambda (file) (if (equal file (car (last files))) "old.snapshot.el" title)))
              ((symbol-function 'read-file-name) (lambda (&rest _) "/other/run.el"))
              ((symbol-function 'completing-read)
               (lambda (_prompt choices _predicate _match _initial _history default)
                 (setq saw-choices (mapcar #'car choices))
                 (should (equal default (format "%s  [one.snapshot.el]" title)))
                 (if browse (car (last saw-choices)) (cadr saw-choices)))))
      (should (equal (gptel-runner-ui--read-session) (cadr files)))
      (should (member "old.snapshot.el" saw-choices))
      (should (equal (cadr saw-choices) (format "%s  [two.snapshot.el]" title)))
      (setq browse t)
      (should (equal (gptel-runner-ui--read-session t) "/other/run.el"))
      (cl-letf (((symbol-function 'gptel-runner-list-snapshots) (lambda () files)))
        (should (equal (gptel-runner-ui--read-session) "/other/run.el"))))))

(ert-deftest gptel-runner-jobs-ui-menu-routing-preserves-local-menu ()
  (let ((gptel-runner-dashboard-row-action-functions
         '(gptel-runner-jobs-ui--row-action))
        local remote)
    (with-temp-buffer
      (cl-letf (((symbol-function 'tabulated-list-get-id)
                 (lambda () '(run "run-1")))
                ((symbol-function 'gptel-runner-background-menu)
                 (lambda () (interactive) (setq remote t))))
        (gptel-runner-ui--dispatch-menu (lambda () (setq local t)))
        (should local)
        (should-not remote))
      (cl-letf (((symbol-function 'tabulated-list-get-id)
                 (lambda () '(background-run "invocation-1")))
                ((symbol-function 'gptel-runner-background-menu)
                 (lambda () (interactive) (setq remote t))))
        (gptel-runner-ui--dispatch-menu
         (lambda () (ert-fail "External row opened local actions")))
        (should remote)))))

(ert-deftest gptel-runner-jobs-ui-menu-includes-state-aware-cleanup ()
  (dolist (binding '(("x" gptel-runner-background-forget-run
                     gptel-runner-jobs-ui--forgettable-at-point-p)
                    ("X" gptel-runner-background-forget-workflow
                     gptel-runner-jobs-ui--forgettable-workflow-p)
                    ("C" gptel-runner-background-clear-finished
                     gptel-runner-jobs-ui--finished-invocations)
                    (":" gptel-runner-background-command)))
    (let ((suffix (cdr (transient-get-suffix 'gptel-runner-background-menu
                                            (car binding)))))
      (should (eq (plist-get suffix :command) (nth 1 binding)))
      (should (eq (plist-get suffix :inapt-if-not) (nth 2 binding))))))

(ert-deftest gptel-runner-jobs-ui-forgotten-history-stays-hidden-until-restarted ()
  (let ((run '(:id "invocation-1" :epoch 1 :forgotten-epoch 1
               :workflow checks :phase closed :state succeeded
               :calls ((:id "call-1" :epoch 1 :state succeeded)))))
    (cl-letf (((symbol-function 'gptel-runner-invocation-list) (lambda () (list run))))
      (should-not (gptel-runner-jobs-ui--entries))
      (should-not (gptel-runner-jobs-ui--finished-invocations))
      (setq run (plist-put run :epoch 2))
      (should (= (length (gptel-runner-jobs-ui--entries)) 2)))))

(ert-deftest gptel-runner-jobs-ui-cleanup-protects-workers-and-scopes-history ()
  (let* ((finished '(:id "done" :workflow checks :phase closed :state succeeded))
         (active '(:id "active" :workflow checks :phase open :state paused))
         (other '(:id "other" :workflow other :phase closed :state skipped))
         (hidden '(:id "hidden" :workflow checks :phase closed
                   :epoch 1 :forgotten-epoch 1))
         (runs (list finished active other hidden))
         forgotten prompts)
    (with-temp-buffer
      (setq-local gptel-runner-background--target '(background-call "done" 1 "call-1"))
      (cl-letf (((symbol-function 'gptel-runner-jobs-ui--selection)
                 (lambda () (list finished nil gptel-runner-background--target)))
                ((symbol-function 'gptel-runner-invocation-list) (lambda () runs))
                ((symbol-function 'gptel-runner-invocation-forget)
                 (lambda (run prefix) (push (list (plist-get run :id) prefix) forgotten)))
                ((symbol-function 'yes-or-no-p)
                 (lambda (_) (cl-incf prompts) t))
                ((symbol-function 'gptel-runner-dashboard-refresh) #'ignore))
        (setq prompts 0)
        (should (gptel-runner-jobs-ui--forgettable-at-point-p))
        (should-not (gptel-runner-jobs-ui--forgettable-workflow-p))
        (should-error (gptel-runner-background-forget-workflow) :type 'user-error)
        (should (= prompts 0))
        (should-not forgotten)
        ;; A selected call forgets its owning run and passes the prefix through.
        (set-buffer-modified-p t)
        (gptel-runner-background-forget-run '(4))
        (should (equal forgotten '(("done" (4)))))
        (setq forgotten nil)
        (gptel-runner-background-clear-finished)
        (should (equal (reverse forgotten) '(("done" nil) ("other" nil))))
        (setq runs (list finished other hidden) forgotten nil)
        (should (gptel-runner-jobs-ui--forgettable-workflow-p))
        (gptel-runner-background-forget-workflow)
        (should (equal forgotten '(("done" nil))))))))

(ert-deftest gptel-runner-jobs-ui-declining-cleanup-preserves-history ()
  (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) nil))
            ((symbol-function 'gptel-runner-invocation-forget)
             (lambda (&rest _) (ert-fail "Forgot history without confirmation"))))
    (gptel-runner-jobs-ui--forget '((:phase closed)) t "test history")))

(ert-deftest gptel-runner-dashboard-node-messages-refresh-and-open-participants ()
  (let* ((run (gptel-runner-run-create :id "message-test"))
         (call (gptel-runner-call-create
                :node (gptel-runner-node-create :id 'review :kind 'agent)
                :run run))
         (name "*gptel-runner events:message-test*")
         visited)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'gptel-runner-ui--run-at-point) (lambda () run))
                    ((symbol-function 'gptel-runner-ui--call-at-point) (lambda () call))
                    ((symbol-function 'gptel-runner-visit-node-chat)
                     (lambda (r node) (setq visited (list r node)))))
            (gptel-runner-dashboard-messages)
            (should (string-match-p "No node messages" (buffer-string)))
            (gptel-runner--emit run 'node-handoff nil nil
                                '(:from first :to second :message "Unrelated message"))
            (gptel-runner--emit run 'node-follow-up nil nil
                                '(:from review :to draft :message "Which branch?"))
            (gptel-runner--emit run 'node-reply nil nil
                                '(:from draft :to review :message "Use main."))
            (gptel-runner--emit run 'node-handoff nil nil
                                '(:from review :to nil :message "Tests passed."))
            (revert-buffer)
            (should-not (string-match-p "Unrelated message" (buffer-string)))
            (goto-char (point-min))
            (search-forward "Follow-up  review → draft")
            (button-activate (button-at (1- (point))))
            (should (equal visited (list run 'draft)))
            (search-forward "Which branch?")
            (search-forward "Reply  draft → review")
            (search-forward "Use main.")
            (search-forward "Handoff  review → Workflow")
            (search-forward "Tests passed.")))
      (when (get-buffer name) (kill-buffer name)))))

(ert-deftest gptel-runner-jobs-ui-published-messages-link-to-owning-epoch ()
  (let* ((directory (make-temp-file "runner-messages-" t))
         (run (list :id "test" :directory directory
                    :calls '((:id "c1" :node planner :epoch 1 :chat "1.el")
                             (:id "c2" :node planner :epoch 2 :chat "2.el"))))
         selection)
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "events.el" directory)
            (insert (gptel-runner-jobs--data-string
                     '(:epoch 1 :time 1.0 :type node-handoff
                       :data (:from planner :to reviewer :message "Review this plan.")))
                    "(:epoch 1"))
          (with-temp-buffer
            (gptel-runner-jobs-ui--insert-messages run nil)
            (should (string-match-p "Review this plan" (buffer-string)))
            (goto-char (point-min))
            (search-forward "planner")
            (cl-letf (((symbol-function 'gptel-runner-background-visit)
                       (lambda (target) (setq selection target))))
              (button-activate (button-at (1- (point)))))
            (should (equal selection '(background-call "test" 1 "c1")))))
      (delete-directory directory t))))

(ert-deftest gptel-runner-dashboard-feedback-targets-selected-waiting-chat ()
  (let* ((call (gptel-runner-call-create
                :node (gptel-runner-node-create :id 'review :kind 'agent)
                :buffer (current-buffer) :state 'waiting-feedback))
         sent)
    (cl-letf (((symbol-function 'gptel-runner-ui--call-at-point) (lambda () call))
              ((symbol-function 'read-string) (lambda (&rest _) "Check the tests."))
              ((symbol-function 'gptel-runner-gptel-feedback)

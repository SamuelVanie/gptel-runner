;;; gptel-runner-jobs-ui-test.el --- Background UI tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'gptel-runner-jobs-ui)

(ert-deftest gptel-runner-jobs-ui-observation-is-lazy-and-does-not-restore ()
  (let ((gptel-runner--runs (make-hash-table :test #'equal))
        (gptel-runner--workflows (make-hash-table :test #'eq))
        (gptel-runner-dashboard-entry-functions
         '(gptel-runner-jobs-ui--entries))
        (gptel-runner-dashboard-columns '(workflow run node state))
        (manifest '(:id "invocation-1" :workflow inspect :state running
                    :calls ((:id "call-2" :epoch 1 :node inspect :state succeeded)
                            (:id "call-2" :epoch 2 :node inspect :state running)))))
    (cl-letf (((symbol-function 'gptel-runner-invocation-list)
               (lambda () (list manifest)))
              ((symbol-function 'gptel-runner-load-run)
               (lambda (&rest _) (ert-fail "Observation restored execution")))
              ((symbol-function 'gptel-runner-invocation-call)
               (lambda (&rest _) (ert-fail "Refresh read a full call")))
              ((symbol-function 'gptel-runner-invocation-outputs)
               (lambda (&rest _) (ert-fail "Refresh read outputs"))))
      (let ((rows (gptel-runner-ui--entries)))
        (should (= (length rows) 3))
        (should (equal (mapcar #'car rows)
                       '((background-run "invocation-1")
                         (background-call "invocation-1" 1 "call-2")
                         (background-call "invocation-1" 2 "call-2"))))
        (should (= (hash-table-count gptel-runner--runs) 0))))))

(ert-deftest gptel-runner-jobs-ui-source-preserves-local-entries ()
  (let ((gptel-runner-dashboard-entry-functions (list (lambda () '((external []))))))
    (cl-letf (((symbol-function 'gptel-runner-ui--local-entries)
               (lambda () '((local [])))))
      (should (equal (gptel-runner-ui--entries) '((local []) (external [])))))))

(ert-deftest gptel-runner-jobs-ui-columns-show-captured-job-and-agent ()
  (let ((gptel-runner-dashboard-columns '(agent job))
        (manifest '(:id "invocation-1" :job-id "job-1"
                    :job (:name "Nightly checks") :workflow checks :state running
                    :calls ((:id "call-2" :epoch 1 :node inspect
                             :agent security-reviewer :state running)))))
    (cl-letf (((symbol-function 'gptel-runner-invocation-list)
               (lambda () (list manifest))))
      (should (equal (mapcar #'car (append (gptel-runner-ui--format) nil))
                     '("Job" "Agent")))
      (let ((rows (gptel-runner-jobs-ui--entries)))
        (should (equal (cadar rows) ["Nightly checks" ""]))
        (should (equal (cadr (cadr rows)) ["Nightly checks" "security-reviewer"])))
      (should (equal gptel-runner-dashboard-columns '(agent job))))))

(ert-deftest gptel-runner-jobs-ui-local-calls-populate-agent-column ()
  (let* ((gptel-runner-dashboard-columns '(job agent))
         (run (gptel-runner-run-create
               :id "run-1" :iterations (make-hash-table :test #'equal)
               :budget (gptel-runner-budget-create)))
         (call (gptel-runner-call-create
                :run run :node (gptel-runner-node-create :id 'inspect)
                :agent (gptel-runner-agent-create :name 'reviewer))))
    (should (equal (cadr (gptel-runner-ui--call-entry run call)) ["" "reviewer"]))))

(ert-deftest gptel-runner-jobs-ui-reap-is-asynchronous-throttled-and-root-scoped ()
  (let ((system-type 'darwin)
        (gptel-runner-jobs-ui--reap-process nil)
        (gptel-runner-jobs-ui--last-reap-time nil)
        (gptel-runner-job-directory "/private/tmp/a root with spaces/")
        commands)
    (unwind-protect
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest arguments)
                     (push (plist-get arguments :command) commands)
                     'fake-reap))
                  ((symbol-function 'processp) (lambda (value) (eq value 'fake-reap)))
                  ((symbol-function 'process-live-p) (lambda (_) t)))
          (gptel-runner-jobs-ui--maybe-reap)
          (should (= (length commands) 1))
          (setq gptel-runner-jobs-ui--last-reap-time 0)
          (gptel-runner-jobs-ui--maybe-reap)
          (should (= (length commands) 1))
          (setq gptel-runner-jobs-ui--reap-process nil
                gptel-runner-jobs-ui--last-reap-time (float-time))
          (gptel-runner-jobs-ui--maybe-reap)
          (should (= (length commands) 1))
          (let* ((command (car commands))
                 (form (read (car (last command)))))
            (should (equal (car command) gptel-runner-job-emacs-program))
            (should (member "--batch" command))
            (should (equal (cadr (car (cadr form)))
                           "/private/tmp/a root with spaces/"))
            (should (equal (car (last form)) '(gptel-runner-launchd-reap)))))
      (when-let* ((buffer (get-buffer "*gptel-runner cleanup log*")))
        (kill-buffer buffer)))))

(ert-deftest gptel-runner-jobs-ui-reap-launch-failure-does-not-break-refresh ()
  (let ((system-type 'darwin)
        (gptel-runner-jobs-ui--reap-process nil)
        (gptel-runner-jobs-ui--last-reap-time nil)
        printed)
    (unwind-protect
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest _) (error "Could not launch test executable")))
                  ((symbol-function 'tabulated-list-print)
                   (lambda (&rest _) (setq printed t))))
          (gptel-runner-jobs-refresh)
          (should printed)
          (with-current-buffer "*gptel-runner cleanup log*"
            (should (string-match-p "Could not launch test executable" (buffer-string)))))
      (when-let* ((buffer (get-buffer "*gptel-runner cleanup log*")))
        (kill-buffer buffer)))))

(ert-deftest gptel-runner-jobs-ui-run-reports-skipped-triggers ()
  (let (reported)
    (cl-letf (((symbol-function 'gptel-runner-jobs-ui--job) (lambda () '(:id "job-1")))
              ((symbol-function 'gptel-runner-job-run)
               (lambda (&rest _) '(:id "invocation-1" :state skipped)))
              ((symbol-function 'gptel-runner-show-dashboard) #'ignore)
              ((symbol-function 'message)
               (lambda (format-string &rest arguments)
                 (setq reported (apply #'format format-string arguments)))))
      (gptel-runner-jobs-run)
      (should (string-prefix-p "Skipped background invocation invocation-1" reported)))))

(ert-deftest gptel-runner-jobs-ui-commands-address-the-observed-call-epoch ()
  (let ((run '(:id "invocation-1" :epoch 3 :state running
               :calls ((:id "call-2" :epoch 2 :state waiting-feedback))))
        sent)
    (with-temp-buffer
      (setq-local gptel-runner-background--target
                  '(background-call "invocation-1" 2 "call-2"))
      (cl-letf (((symbol-function 'gptel-runner-invocation-get)
                 (lambda (_id) run))
                ((symbol-function 'gptel-runner-job-command)
                 (lambda (invocation operation arguments)
                   (setq sent (list invocation operation arguments))
                   '(:id "command-1" :state queued)))
                ((symbol-function 'gptel-runner-jobs-ui--display) #'ignore))
        (gptel-runner-background-command 'accept '(:result "accepted"))
        (should (eq (nth 1 sent) 'accept))
        (should (equal (plist-get (nth 2 sent) :call-id) "call-2"))
        (should (= (plist-get (nth 2 sent) :call-epoch) 2))
        (should (equal (plist-get (nth 2 sent) :result) "accepted"))))))

(ert-deftest gptel-runner-jobs-ui-rejects-a-vanished-call ()
  (with-temp-buffer
    (setq-local gptel-runner-background--target
                '(background-call "invocation-1" 1 "call-2"))
    (cl-letf (((symbol-function 'gptel-runner-invocation-get)
               (lambda (_id) '(:id "invocation-1" :calls nil)))
              ((symbol-function 'gptel-runner-job-command)
               (lambda (&rest _) (ert-fail "Sent command for a vanished call"))))
      (should-error (gptel-runner-background-command 'cancel-call)
                    :type 'user-error))))

(ert-deftest gptel-runner-jobs-ui-historical-retry-targets-node-not-dead-call ()
  (let ((run '(:id "invocation-1" :epoch 2 :state failed
               :calls ((:id "call-2" :epoch 1 :node inspect :state succeeded))))
        sent)
    (with-temp-buffer
      (setq-local gptel-runner-background--target
                  '(background-call "invocation-1" 1 "call-2"))
      (cl-letf (((symbol-function 'gptel-runner-invocation-get) (lambda (_) run))
                ((symbol-function 'gptel-runner-job-command)
                 (lambda (_run _operation arguments)
                   (setq sent arguments) '(:id "command-3" :status queued)))
                ((symbol-function 'gptel-runner-jobs-ui--display) #'ignore)
                ((symbol-function 'read-string) (lambda (&rest _) "Retry inspection")))
        (gptel-runner-background-command 'retry)
        (should (eq (plist-get sent :from-node) 'inspect))
        (should (equal (plist-get sent :feedback) "Retry inspection"))
        (should-not (plist-member sent :call-id))
        (should-not (plist-member sent :call-epoch))))))

(ert-deftest gptel-runner-jobs-ui-approval-opens-review-without-submitting ()
  (require 'gptel-runner-jobs-panel)
  (let (opened)
    (cl-letf (((symbol-function 'gptel-runner-background-open)
               (lambda () (setq opened t)))
              ((symbol-function 'gptel-runner-job-command)
               (lambda (&rest _) (ert-fail "Approved before review"))))
      (gptel-runner-background-command 'approve)
      (should opened))))

(ert-deftest gptel-runner-jobs-ui-editor-reads-data-without-evaluation ()
  (let (saved)
    (with-temp-buffer
      (gptel-runner-job-edit-mode)
      (insert "(:name \"Example\" :workflow demo :arguments (:goal (error \"executed\")))")
      (cl-letf (((symbol-function 'gptel-runner-job-save)
                 (lambda (data) (setq saved data) (plist-put data :id "job-1"))))
        (gptel-runner-job-edit-save)
        (should (equal (plist-get (plist-get saved :arguments) :goal)
                       '(error "executed")))
        (should (equal gptel-runner-job-edit--id "job-1"))
        (should-not (buffer-modified-p))))))

(ert-deftest gptel-runner-jobs-ui-editor-rejects-trailing-forms-and-id-changes ()
  (with-temp-buffer
    (gptel-runner-job-edit-mode)
    (cl-letf (((symbol-function 'gptel-runner-job-save)
               (lambda (_) (ert-fail "Invalid editor input reached save"))))
      (insert "(:name \"Example\") (message \"extra\")")
      (should-error (gptel-runner-job-edit-save) :type 'user-error)
      (erase-buffer)
      (setq-local gptel-runner-job-edit--id "job-1")
      (insert "(:id \"job-2\" :name \"Example\")")
      (should-error (gptel-runner-job-edit-save) :type 'user-error))))

(ert-deftest gptel-runner-jobs-ui-artifacts-cannot-escape-invocation ()
  (let ((directory (make-temp-file "runner-ui-artifacts-" t))
        (outside (make-temp-file "runner-ui-outside-")))
    (unwind-protect
        (let ((run (list :directory directory)))
          (make-symbolic-link outside (expand-file-name "escape" directory))
          (should-error (gptel-runner-jobs-ui--artifact-path run outside)
                        :type 'user-error)
          (should-error (gptel-runner-jobs-ui--artifact-path run "escape")
                        :type 'user-error))
      (delete-directory directory t)
      (delete-file outside))))

(ert-deftest gptel-runner-jobs-ui-menu-routing-preserves-local-menu ()
  (let ((gptel-runner-dashboard-row-action-functions
         '(gptel-runner-jobs-ui--row-action))
        local remote)
    (with-temp-buffer
      (cl-letf (((symbol-function 'tabulated-list-get-id)
                 (lambda () '(run "run-1")))
                ((symbol-function 'gptel-runner-background-menu)
                 (lambda () (interactive) (setq remote t))))
        (gptel-runner-ui--dispatch-menu (lambda () (setq local t)))
        (should local)
        (should-not remote))
      (cl-letf (((symbol-function 'tabulated-list-get-id)
                 (lambda () '(background-run "invocation-1")))
                ((symbol-function 'gptel-runner-background-menu)
                 (lambda () (interactive) (setq remote t))))
        (gptel-runner-ui--dispatch-menu
         (lambda () (ert-fail "External row opened local actions")))
        (should remote)))))

(ert-deftest gptel-runner-jobs-ui-menu-includes-state-aware-cleanup ()
  (dolist (binding '(("x" gptel-runner-background-forget-run
                     gptel-runner-jobs-ui--forgettable-at-point-p)
                    ("X" gptel-runner-background-forget-workflow
                     gptel-runner-jobs-ui--forgettable-workflow-p)
                    ("C" gptel-runner-background-clear-finished
                     gptel-runner-jobs-ui--finished-invocations)
                    (":" gptel-runner-background-command)))
    (let ((suffix (cdr (transient-get-suffix 'gptel-runner-background-menu
                                            (car binding)))))
      (should (eq (plist-get suffix :command) (nth 1 binding)))
      (should (eq (plist-get suffix :inapt-if-not) (nth 2 binding))))))

(ert-deftest gptel-runner-jobs-ui-forgotten-history-stays-hidden-until-restarted ()
  (let ((run '(:id "invocation-1" :epoch 1 :forgotten-epoch 1
               :workflow checks :phase closed :state succeeded
               :calls ((:id "call-1" :epoch 1 :state succeeded)))))
    (cl-letf (((symbol-function 'gptel-runner-invocation-list) (lambda () (list run))))
      (should-not (gptel-runner-jobs-ui--entries))
      (should-not (gptel-runner-jobs-ui--finished-invocations))
      (setq run (plist-put run :epoch 2))
      (should (= (length (gptel-runner-jobs-ui--entries)) 2)))))

(ert-deftest gptel-runner-jobs-ui-cleanup-protects-workers-and-scopes-history ()
  (let* ((finished '(:id "done" :workflow checks :phase closed :state succeeded))
         (active '(:id "active" :workflow checks :phase open :state paused))
         (other '(:id "other" :workflow other :phase closed :state skipped))
         (hidden '(:id "hidden" :workflow checks :phase closed
                   :epoch 1 :forgotten-epoch 1))
         (runs (list finished active other hidden))
         forgotten prompts)
    (with-temp-buffer
      (setq-local gptel-runner-background--target '(background-call "done" 1 "call-1"))
      (cl-letf (((symbol-function 'gptel-runner-jobs-ui--selection)
                 (lambda () (list finished nil gptel-runner-background--target)))
                ((symbol-function 'gptel-runner-invocation-list) (lambda () runs))
                ((symbol-function 'gptel-runner-invocation-forget)
                 (lambda (run prefix) (push (list (plist-get run :id) prefix) forgotten)))
                ((symbol-function 'yes-or-no-p)
                 (lambda (_) (cl-incf prompts) t))
                ((symbol-function 'gptel-runner-dashboard-refresh) #'ignore))
        (setq prompts 0)
        (should (gptel-runner-jobs-ui--forgettable-at-point-p))
        (should-not (gptel-runner-jobs-ui--forgettable-workflow-p))
        (should-error (gptel-runner-background-forget-workflow) :type 'user-error)
        (should (= prompts 0))
        (should-not forgotten)
        ;; A selected call forgets its owning run and passes the prefix through.
        (set-buffer-modified-p t)
        (gptel-runner-background-forget-run '(4))
        (should (equal forgotten '(("done" (4)))))
        (setq forgotten nil)
        (gptel-runner-background-clear-finished)
        (should (equal (reverse forgotten) '(("done" nil) ("other" nil))))
        (setq runs (list finished other hidden) forgotten nil)
        (should (gptel-runner-jobs-ui--forgettable-workflow-p))
        (gptel-runner-background-forget-workflow)
        (should (equal forgotten '(("done" nil))))))))

(ert-deftest gptel-runner-jobs-ui-declining-cleanup-preserves-history ()
  (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) nil))
            ((symbol-function 'gptel-runner-invocation-forget)
             (lambda (&rest _) (ert-fail "Forgot history without confirmation"))))
    (gptel-runner-jobs-ui--forget '((:phase closed)) t "test history")))


(ert-deftest gptel-runner-dashboard-reviews-only-displayed-tool-requests ()
  (let* ((node (gptel-runner-node-create :id 'inspect :kind 'agent))
         (call (gptel-runner-call-create :id "ui-test" :node node :state 'waiting-confirmation))
         (first '(:id "1" :source-buffer "reader" :tools ((:name "Read" :args (:path "main.el")))))
         (second '(:id "2" :source-buffer "child" :tools ((:name "Read" :args (:path "test.el")))))
         (third '(:id "3" :source-buffer "reader" :tools ((:name "Write" :args (:path "draft.el")))))
         (pending (list first second))
         (gptel-runner-dashboard-row-action-functions nil)
         approved review)
    (cl-letf (((symbol-function 'gptel-runner-ui--call-at-point) (lambda () call))
              ((symbol-function 'gptel-runner-gptel-pending-interactions)
               (lambda (owner) (should (eq owner call)) pending))
              ((symbol-function 'gptel-runner-gptel-approve-interactions)
               (lambda (owner ids)
                 (should (eq owner call))
                 (setq approved ids
                       pending (cl-remove-if (lambda (item) (member (plist-get item :id) ids))
                                             pending)))))
      (unwind-protect
          (save-window-excursion
            (should (equal (gptel-runner-ui--call-state call) "2 approvals pending"))
            (gptel-runner-dashboard-open-at-point)
            (setq review (current-buffer))
            (should (derived-mode-p 'gptel-runner-tool-review-mode))
            (should-not approved)
            (should (search-forward "test.el" nil t))
            (push third pending)
            (call-interactively (key-binding (kbd "a")))
            (should (equal approved '("1" "2")))
            (should (search-forward "draft.el" nil t))
            (call-interactively (key-binding (kbd "TAB")))
            (should (equal (button-label (button-at (point))) "Approve once"))
            (call-interactively (key-binding (kbd "RET")))
            (should (equal approved '("3")))
            (should (search-forward "No pending tool approvals" nil t))
            (should-error (call-interactively (key-binding (kbd "a"))) :type 'user-error))
        (when (buffer-live-p review) (kill-buffer review))))))


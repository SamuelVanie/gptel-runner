                (cadr binding)))))

(ert-deftest gptel-runner-jobs-ui-removes-only-the-selected-definition ()
  (let ((gptel-runner-job-directory (make-temp-file "runner-ui-delete-" t))
        (system-type 'gnu/linux)
        (gptel-runner-jobs-ui--last-reap-time (float-time))
        (gptel-runner-job-launch-function #'ignore)
        (init (locate-library "gptel-runner"))
        confirm)
    (unwind-protect
        (with-temp-buffer
          (dolist (id '("nightly" "manual"))
            (gptel-runner-register-job id :name "Checks" :workflow 'checks :init-file init))
          (let ((run (gptel-runner-job-run "nightly")))
            (gptel-runner-jobs-mode)
            (gptel-runner-jobs-refresh)
            (goto-char (point-min))
            (unless (equal (tabulated-list-get-id) "nightly") (forward-line))
            (should (equal (tabulated-list-get-id) "nightly"))
            (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) confirm)))
              (call-interactively (key-binding (kbd "x")))
              (should (= (length (gptel-runner-job-list)) 2))
              (setq confirm t)
              (call-interactively (key-binding (kbd "x"))))
            (should (equal (mapcar (lambda (job) (plist-get job :id))
                                   (gptel-runner-job-list))
                           '("manual")))
            (goto-char (point-min))
            (should (equal (tabulated-list-get-id) "manual"))
            (forward-line)
            (should-not (tabulated-list-get-id))
            (should-error (gptel-runner-jobs-remove) :type 'user-error)
            (should (equal run (gptel-runner-invocation-get (plist-get run :id))))))
      (delete-directory gptel-runner-job-directory t))))

(ert-deftest gptel-runner-jobs-ui-clears-finished-runs-of-the-selected-job ()
  (let* ((job '(:id "nightly" :workflow checks :name "Checks"))
         (runs '((:id "done" :job-id "nightly" :workflow checks :phase closed)
                 (:id "active" :job-id "nightly" :workflow checks :phase open)
                 (:id "sibling" :job-id "manual" :workflow checks :phase closed)
                 (:id "hidden" :job-id "nightly" :workflow checks :phase closed
                      :epoch 1 :forgotten-epoch 1)))
         (gptel-runner-dashboard-buffer (generate-new-buffer-name " *runs-test*"))
         forgotten)
    (with-temp-buffer
      (gptel-runner-jobs-mode)
      (cl-letf (((symbol-function 'gptel-runner-job-list) (lambda () (list job)))
                ((symbol-function 'gptel-runner-job-get)
                 (lambda (id) (and (equal id (plist-get job :id)) job)))
                ((symbol-function 'gptel-runner-invocation-list) (lambda () runs))
                ((symbol-function 'gptel-runner-invocation-forget)
                 (lambda (run prefix)
                   (push (list (plist-get run :id) prefix) forgotten)
                   (setq runs (remq run runs))))
                ((symbol-function 'yes-or-no-p) (lambda (_) t)))
        (tabulated-list-print)
        (goto-char (point-min))
        (let ((current-prefix-arg '(4)))
          (call-interactively (key-binding (kbd "C"))))
        (should (equal forgotten '(("done" (4)))))
        (should-error (gptel-runner-jobs-clear-finished) :type 'user-error)
        (should (equal forgotten '(("done" (4)))))
        (goto-char (point-max))
        (should-error (gptel-runner-jobs-clear-finished) :type 'user-error)))))


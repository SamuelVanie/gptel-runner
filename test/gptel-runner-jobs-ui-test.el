        (manifest '(:id "invocation-1" :job-id "job-1"
                    :job (:name "Nightly checks") :workflow checks :state running
                    :calls ((:id "call-2" :epoch 1 :node inspect
                             :agent security-reviewer :state running)))))
    (cl-letf (((symbol-function 'gptel-runner-invocation-list)
               (lambda () (list manifest))))
      (should (equal (mapcar #'car (append (gptel-runner-ui--format) nil))
                     '("Job" "Agent")))
      (let ((rows (gptel-runner-jobs-ui--entries)))
        (should (equal (cadar rows) ["Nightly checks" ""]))
        (should (equal (cadr (cadr rows)) ["Nightly checks" "security-reviewer"])))
      (should (equal gptel-runner-dashboard-columns '(agent job))))))

